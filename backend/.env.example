# Copy to backend/.env for local dev (never commit .env)
MONGODB_URL=mongodb+srv://USER:PASS@cluster.mongodb.net/gastric_cancer_fl?retryWrites=true&w=majority
DATABASE_NAME=gastric_cancer_fl
SECRET_KEY=replace_with_random_secret

FRONTEND_URL=http://localhost:5173

# Email: Resend (HTTPS — works on Render free tier). Get key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx
# Verified domain in Resend, e.g. "App Name <noreply@yourdomain.com>"
# For quick tests Resend may allow onboarding@resend.dev — see Resend docs.
RESEND_FROM=Gastric Cancer FL <onboarding@resend.dev>

# Optional: skip email and auto-verify signups (demos only — not for production)
# AUTO_VERIFY_EMAIL=true

# On Render Free, SMTP is blocked: use RESEND_* above, or set to avoid wasted SMTP attempts:
# SKIP_SMTP=true

# Optional: Gmail SMTP (often blocked on Render free)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
